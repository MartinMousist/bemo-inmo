# Caddy: TLS, archivos estáticos y proxy a la API.
#
# Caddy y no nginx por una razón concreta: resuelve el certificado de Let's
# Encrypt solo, lo renueva solo, y redirige HTTP a HTTPS sin que nadie escriba
# un bloque para eso. En un producto que maneja plata de terceros, el TLS que
# nadie tiene que acordarse de renovar es el que sigue funcionando en marzo.
#
# `DOMINIO` y `API_UPSTREAM` vienen del entorno (ver docker-compose.prod.yml).

{
	# El mail de Let's Encrypt: es donde avisan si un certificado va a vencer.
	email {$ACME_EMAIL}
	# Sin el servidor de administración: es una API de control y acá no se usa.
	admin off
}

{$DOMINIO} {
	encode zstd gzip

	# ── Cabeceras de seguridad ────────────────────────────────────────────────
	#
	# La app ya manda las suyas con helmet, pero eso protege a las respuestas de
	# la API. El HTML estático sale de acá y necesita las propias.
	header {
		# Un año, con subdominios. Va después de comprobar que el TLS funciona:
		# con HSTS puesto, un certificado roto deja el sitio inaccesible.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# El sitio no se embebe en ningún lado: es una app de gestión.
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Sin cámara, micrófono ni geolocalización: nada de la app los usa.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

		# ── Content-Security-Policy ───────────────────────────────────────────
		#
		# Entra con el editor de plantillas (migración 023), y el motivo es
		# concreto: desde ahí la app guarda HTML que después se pinta con
		# `v-html` en la hoja imprimible. Hoy eso es seguro porque el ÚNICO
		# camino de escritura pasa por `plantillas.sanitizar.ts`. El día que
		# aparezca otro —un importador, un script de mantenimiento, un endpoint
		# nuevo— deja de serlo sin que nada avise. Esta cabecera es lo que hace
		# que ese día sea una molestia y no un incidente: un `<script>` que se
		# filtrara igual no corre.
		#
		# `script-src 'self'`: sin `unsafe-inline` y sin `unsafe-eval`. Vite
		# compila todo a archivos con hash; no hay scripts en línea en el HTML.
		# `style-src` sí lleva `unsafe-inline`: Vue inyecta estilos en línea para
		# las transiciones y los `:style` calculados, y sacarlo rompería la app
		# entera para no ganar nada (un `style` no ejecuta código).
		# `img-src` incluye `data:` por el favicon SVG inline del index, y `blob:`
		# por las previsualizaciones de foto antes de subirlas.
		# `frame-src` deja pasar Google Maps: el mapa de la ficha es un `<iframe>`
		# a `www.google.com/maps?…&output=embed`, que funciona sin API key.
		# `connect-src 'self'`: la API va por el mismo origen (ver el bloque de
		# abajo), así que no hace falta ningún otro destino.
		# `object-src 'none'` y `base-uri 'none'`: nada de plugins, y nadie puede
		# reescribir a dónde resuelven las URLs relativas de la página.
		#
		# ⚠️ Los dos orígenes de fuentes son obligatorios y hay que comprobarlos
		# en el navegador: una CSP que rompe la tipografía se desactiva a la
		# semana, y entonces no protege nada.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; font-src 'self' https://fonts.gstatic.com https://cdn.fontshare.com; img-src 'self' data: blob: https:; connect-src 'self'; frame-src https://www.google.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"

		# Caddy y su versión, fuera de las respuestas.
		-Server
	}

	# ── La API ────────────────────────────────────────────────────────────────
	#
	# Mismo origen que el front, a propósito: así la cookie httpOnly del refresh
	# no es de terceros, y no depende de que el navegador la acepte. Con la API
	# en otro dominio, Safari y los bloqueadores la descartan.
	handle_path /v1/* {
		reverse_proxy {$API_UPSTREAM} {
			header_up X-Real-IP {remote_host}
			# La app corre con `trust proxy: 1` y lee de acá la IP real. Con la
			# IP equivocada, el límite de intentos cuenta a todos como uno solo.
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# ── El front ──────────────────────────────────────────────────────────────
	handle {
		root * /srv

		# Los assets llevan hash en el nombre: se cachean para siempre.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# El index NO se cachea: es el que apunta a los assets nuevos después de
		# cada deploy. Cacheado, un usuario sigue viendo la versión anterior.
		@index path /
		header @index Cache-Control "no-cache"

		# SPA: cualquier ruta que no sea un archivo cae en el index y la resuelve
		# el router. Sin esto, recargar en `/contratos/abc` da un 404 de Caddy.
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
