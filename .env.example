# Copiar a .env y completar. Sin esto la app NO levanta: no hay defaults inseguros.
# .env está en .gitignore. Nunca commitear secretos.

DB_NAME=bemo_inmo

# Rol dueño del schema. Sólo lo usa el migrador.
DB_OWNER_USER=inmo_owner
DB_OWNER_PASSWORD=cambiame_owner

# Rol restringido con el que corre la app. Es al que le aplica RLS.
DB_APP_USER=inmo_app
DB_APP_PASSWORD=cambiame_app

DB_PORT=5432
API_PORT=3000
WEB_PORT=5173

# Secreto de firma de los access tokens. Mínimo 32 caracteres.
# Generar uno con:  openssl rand -base64 48
JWT_SECRET=cambiame_por_uno_generado_de_al_menos_32_caracteres

# ── Google Maps (opcional) ────────────────────────────────────────────────────
# Sin esto la app funciona igual: NO inventa coordenadas, y cada ficha ofrece
# cargar latitud y longitud a mano diciendo por qué.
#
# Para que funcione hacen falta las tres cosas, no sólo la key:
#   1. Habilitar la **Geocoding API** en el proyecto de Google Cloud.
#   2. Activar la **facturación** del proyecto. Google la exige aunque el uso
#      entre en el crédito mensual gratuito.
#   3. Restringir la key **por dirección IP** (la del servidor), NO por HTTP
#      referrer: las consultas salen del backend, no del navegador. Una key
#      restringida por referrer devuelve REQUEST_DENIED y parece una key mala.
#
# Con la key puesta, Propiedades muestra un panel para ubicar en tanda las que
# se cargaron antes (POST /v1/propiedades/geocoding/sincronizar), y
# GET /v1/propiedades/geocoding/diagnostico prueba la key contra Google.
#
# Costo: se geocodifica UNA vez por propiedad y se guarda; el mapa interactivo
# se carga sólo cuando el usuario lo pide. Ver DESIGN.md §6.
GOOGLE_MAPS_API_KEY=

# Almacenamiento de fotos y documentos (MinIO en dev, S3/R2/Spaces en prod)
S3_BUCKET=bemo-inmo
S3_ACCESS_KEY=inmo_s3_dev
S3_SECRET_KEY=cambiame_s3_dev_min8
S3_PORT=9000
S3_CONSOLE_PORT=9001
