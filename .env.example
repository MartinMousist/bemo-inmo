# Copiar a .env y completar. Sin esto la app NO levanta: no hay defaults inseguros.
# .env está en .gitignore. Nunca commitear secretos.

DB_NAME=bemo_inmo

# Rol dueño del schema. Sólo lo usa el migrador.
DB_OWNER_USER=inmo_owner
DB_OWNER_PASSWORD=cambiame_owner

# Rol restringido con el que corre la app. Es al que le aplica RLS.
DB_APP_USER=inmo_app
DB_APP_PASSWORD=cambiame_app

DB_PORT=5432
API_PORT=3000
WEB_PORT=5173

# Secreto de firma de los access tokens. Mínimo 32 caracteres.
# Generar uno con:  openssl rand -base64 48
JWT_SECRET=cambiame_por_uno_generado_de_al_menos_32_caracteres

# ── Google Maps (opcional) ────────────────────────────────────────────────────
# Sin esto la app funciona igual: NO inventa coordenadas, y cada ficha ofrece
# cargar latitud y longitud a mano diciendo por qué.
#
# QUÉ HABILITA ESTA KEY, EXACTAMENTE: geocodificar, o sea pasar de una dirección
# a lat/lng. NADA MÁS. El mapa de la ficha de una propiedad que ya tiene
# coordenadas es un <iframe> a www.google.com/maps?q=…&output=embed, que NO lleva
# key y funciona hoy sin ella (verificado: HTTP 200 desde el contenedor de la
# API). Por eso GET /v1/propiedades/capacidades devuelve las dos por separado:
# { geocodificacion, mapaEmbebido }.
#
# Para que la geocodificación funcione hacen falta CUATRO cosas, no sólo la key:
#   1. Habilitar la **Geocoding API** en el proyecto de Google Cloud. Sólo esa:
#      el código no usa Maps JavaScript API ni Maps Embed API.
#   2. Activar la **facturación** del proyecto. Google la exige aunque el uso
#      entre en el crédito mensual gratuito; sin eso el diagnóstico devuelve
#      OVER_QUERY_LIMIT.
#   3. **Restricción de aplicación → Direcciones IP**, con la IP pública de
#      SALIDA del servidor donde corre la API (se saca desde ahí con
#      `curl -s ifconfig.me`). NUNCA «Sitios web (referente HTTP)»: las consultas
#      salen del backend con fetch, sin cabecera Referer, y una key restringida
#      por referrer devuelve REQUEST_DENIED — que parece una key mal copiada.
#   4. **Restricción de API → Geocoding API**. Es un ajuste DISTINTO del de IP y
#      está en la misma pantalla: sin él, una key filtrada habilita todo lo demás
#      del proyecto. Los dos se ponen juntos o el punto 3 protege a medias.
#
# Conviene además un tope de cuota diario en «APIs y servicios → Geocoding API →
# Cuotas» (200/día sobra: se geocodifica UNA vez por propiedad) y una alerta de
# presupuesto en Facturación.
#
# CÓMO SE APLICA: se pone acá y se levanta con `docker compose up -d api`.
# `docker compose restart api` NO sirve: reinicia el contenedor con el entorno
# con el que se creó y el .env nuevo no entra. Se verifica con
#   docker compose exec -T api sh -c 'echo ${#GOOGLE_MAPS_API_KEY}'   → > 30
#   GET /v1/propiedades/geocoding/diagnostico  (owner)  → {"funciona":true,"estado":"OK"}
# Si da REQUEST_DENIED, el campo `mensajeDeGoogle` viene sin traducir: es lo
# único que dice cuál de las cuatro cosas falta.
#
# Con la key puesta, Propiedades muestra un panel para ubicar en tanda las que
# se cargaron antes (POST /v1/propiedades/geocoding/sincronizar). Es idempotente
# y nunca pisa una coordenada con geocode_fuente = 'manual'.
#
# Costo: se geocodifica UNA vez por propiedad y se guarda; el mapa interactivo
# se carga sólo cuando el usuario lo pide. Ver DESIGN.md §6.
GOOGLE_MAPS_API_KEY=

# Almacenamiento de fotos y documentos (MinIO en dev, S3/R2/Spaces en prod)
S3_BUCKET=bemo-inmo
S3_ACCESS_KEY=inmo_s3_dev
S3_SECRET_KEY=cambiame_s3_dev_min8
S3_PORT=9000
S3_CONSOLE_PORT=9001
