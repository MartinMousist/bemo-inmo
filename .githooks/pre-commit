#!/bin/sh
# Activar una vez por clon:  git config core.hooksPath .githooks
set -e

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks no está instalado. Instalalo con:  brew install gitleaks" >&2
  echo "(o salteá este commit con --no-verify, bajo tu responsabilidad)" >&2
  exit 1
fi

gitleaks protect --staged --redact --config .gitleaks.toml
